# App URLs — use production URLs on Netlify (not localhost) so email confirm links work
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Production example:
# NEXT_PUBLIC_APP_URL=https://mayafishmart.netlify.app
# NEXT_PUBLIC_STOREFRONT_URL=https://mayafishmart.netlify.app
# NEXT_PUBLIC_ADMIN_URL=https://mayafishmart-ops.netlify.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (India) — storefront only
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# OpenAI (admin insights + stock vision). Optional — heuristics used if missing.
OPENAI_API_KEY=
