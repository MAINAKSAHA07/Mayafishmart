# App URLs — use production URLs on Netlify (not localhost) so email confirm links work
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Production example:
# NEXT_PUBLIC_APP_URL=https://mayafishmart.netlify.app
# NEXT_PUBLIC_STOREFRONT_URL=https://mayafishmart.netlify.app
# NEXT_PUBLIC_ADMIN_URL=https://mayafishmart-ops.netlify.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (India) — storefront only
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# OpenAI (admin insights + stock vision). Optional — heuristics used if missing.
OPENAI_API_KEY=

# Borzo Business API (India) — storefront delivery + Ops webhook
# Callback URL (Ops): https://mayafishmart-ops.netlify.app/api/webhooks/borzo
BORZO_API_TOKEN=
BORZO_CALLBACK_SECRET=
BORZO_API_BASE=https://robotapitest-in.borzodelivery.com/api/business/1.8
# Shop pickup point (Manpada defaults baked into code if unset)
BORZO_SHOP_ADDRESS=Shop number 6, TMC GALA, near krishna bar and restaurants, beside happy valley society, Happy Valley, Manpada, Thane West, Thane, Maharashtra 400610, India
BORZO_SHOP_LAT=19.236832678869682
BORZO_SHOP_LNG=72.97205704973466
# Required 10-digit shop mobile for Borzo contact_person
BORZO_SHOP_PHONE=
