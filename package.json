{
  "name": "mayafishmart",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    ".",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:storefront": "next dev --port 3000",
    "dev:admin": "npm run dev --workspace=admin -- --port 3001",
    "dev:all": "npm run dev:storefront & npm run dev:admin",
    "build": "next build",
    "build:storefront": "next build",
    "build:admin": "npm run build --workspace=admin",
    "build:all": "npm run build:storefront && npm run build:admin",
    "start": "next start",
    "start:admin": "npm run start --workspace=admin -- --port 3001",
    "deploy:storefront": "CI=true netlify deploy --trigger --filter mayafishmart -s 23a33c97-018a-42cf-9880-a95dfff621b8",
    "deploy:storefront:local": "netlify deploy --build --prod --filter mayafishmart -s 23a33c97-018a-42cf-9880-a95dfff621b8",
    "deploy:storefront:draft": "netlify deploy --build --filter mayafishmart -s 23a33c97-018a-42cf-9880-a95dfff621b8",
    "deploy:admin": "CI=true netlify deploy --trigger --filter admin -s afec8fbf-c9b6-457b-be58-e73d8255a2e0",
    "deploy:admin:local": "echo 'Local CLI prod deploys break Maya Ops SSR (502). Push to GitHub and use npm run deploy:admin (cloud build with base=apps/admin).' >&2; exit 1",
    "deploy:trigger": "CI=true netlify deploy --trigger --filter mayafishmart -s 23a33c97-018a-42cf-9880-a95dfff621b8",
    "lint": "eslint",
    "lint:admin": "npm run lint --workspace=admin"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
