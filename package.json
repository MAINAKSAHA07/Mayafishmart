{
  "name": "mayafishmart",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:storefront": "next dev --port 3000",
    "dev:admin": "npm run dev --workspace=admin -- --port 3001",
    "dev:all": "npm run dev:storefront & npm run dev:admin",
    "build": "next build",
    "build:storefront": "next build",
    "build:admin": "npm run build --workspace=admin",
    "build:all": "npm run build:storefront && npm run build:admin",
    "start": "next start",
    "start:admin": "npm run start --workspace=admin -- --port 3001",
    "lint": "eslint",
    "lint:admin": "npm run lint --workspace=admin"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
